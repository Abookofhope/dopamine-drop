# Built by tools/build_site.py and by the Pages workflow. Committing it would
# mean two sources of truth for what is deployed.
_site/

# Never commit these.
key.properties
*.jks
*.keystore

# Installed by tools/probe/README.md, not shipped. No trailing slash: with one
# the pattern matches a real directory but not a symlink to somewhere else,
# which is how a link into /tmp nearly got committed.
node_modules
